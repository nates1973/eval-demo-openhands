# Borrowed upstream code: a separate repo with its own history, never committed here.
/OpenHands/

# Raw session and run logs may contain API keys, tokens and Azure endpoints.
# Commit only scrubbed logs (results/runs/**/logs/scrubbed/) and aggregates.
results/runs/**/logs/raw/

# Credentials and local configuration (templates stay committed)
.env
.env.*
!.env.example
config/*.local.*
*.key
*.pem
secrets/
*.secret
.claude/settings.json


# Local tooling
node_modules/
__pycache__/
.venv/
.DS_Store

# Deployment artifacts: VPN client configs (include the tls-auth key), ARM templates and certs
/Deployed_Resources/
