{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "containerGroups_openhands_dev_container_workspaceKey": {
            "type": "SecureString"
        },
        "containerGroups_openhands_dev_container_name": {
            "defaultValue": "openhands-dev-container",
            "type": "String"
        }
    },
    "variables": {},
    "resources": [
        {
            "type": "Microsoft.ContainerInstance/containerGroups",
            "apiVersion": "2026-07-01",
            "name": "[parameters('containerGroups_openhands_dev_container_name')]",
            "location": "eastus",
            "properties": {
                "sku": "Standard",
                "containers": [
                    {
                        "name": "[parameters('containerGroups_openhands_dev_container_name')]",
                        "properties": {
                            "image": "ghcr.io/openhands/agent-canvas:latest",
                            "ports": [
                                {
                                    "protocol": "TCP",
                                    "port": 8000
                                }
                            ],
                            "environmentVariables": [
                                {
                                    "name": "LOCAL_BACKEND_API_KEY",
                                    "value": "OpenHandsEvalsForSogeti2026!"
                                }
                            ],
                            "configMap": {
                                "keyValuePairs": {}
                            },
                            "resources": {
                                "requests": {
                                    "memoryInGB": 4,
                                    "cpu": 2
                                }
                            }
                        }
                    }
                ],
                "initContainers": [],
                "restartPolicy": "Always",
                "ipAddress": {
                    "ports": [
                        {
                            "protocol": "TCP",
                            "port": 8000
                        }
                    ],
                    "type": "Public",
                    "dnsNameLabel": "openhands-nate",
                    "autoGeneratedDomainNameLabelScope": "TenantReuse"
                },
                "osType": "Linux",
                "diagnostics": {
                    "logAnalytics": {
                        "workspaceId": "2f5f26ce-96af-4b08-9e36-ccbd0d41fbfd",
                        "logType": "ContainerInstanceLogs",
                        "workspaceKey": "[parameters('containerGroups_openhands_dev_container_workspaceKey')]"
                    }
                }
            }
        }
    ]
}